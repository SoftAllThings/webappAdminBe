# Server Configuration
NODE_ENV=development
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webappadmin
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database Pool Configuration
DB_MAX_CONNECTIONS=5
DB_IDLE_TIMEOUT=300000
DB_CONNECTION_TIMEOUT=60000

# Authentication (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# BigQuery (Firebase Analytics export) — REQUIRED for /api/bq/*
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=analytics_XXXXXXXXX
# Provide ONE of the following two:
# 1) Full JSON string of the service account key (preferred on Render / hosted envs)
BQ_SERVICE_ACCOUNT_KEY=
# 2) OR local file path (preferred in dev)
BQ_SERVICE_ACCOUNT_PATH=./bqServiceAccountKey.json

# Analyst chat agent — REQUIRED for /api/chat
ANTHROPIC_API_KEY=sk-ant-...
POOPCHECK_MCP_URL=https://us-central1-poopmania-prod.cloudfunctions.net/mcpInsightsServer/mcp
POOPCHECK_MCP_TOKEN=